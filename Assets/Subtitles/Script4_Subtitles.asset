  m_Script: {fileID: 11500000, guid: 11fcc6676c3e1904c8cd219824caa727, type: 3}
  m_Name: Script4_Subtitles
  m_EditorClassIdentifier: 
  lines:
  - timestamp: 1.3
    text: 'Juliet: Not proud you have, but thankful that you have.'
  - timestamp: 5.15
    text: 'Juliet: Proud can I never be of what I hate;'
  - timestamp: 8.5
    text: 'Juliet: But thankful even for hate that is meant love.'
  - timestamp: 12.1
    text: 'Capulet: How, how, how, how, chopped-logic! What is this?'
  - timestamp: 16.75
    text: 'Capulet: ''Proud,'' and ''I thank you,'' and ''I thank you not,'''
  - timestamp: 20.65
    text: 'Capulet: And yet ''not proud,'' mistress minion, you?'
  - timestamp: 25
    text: 'Capulet: Thank me no thankings, nor proud me no prouds;'
  - timestamp: 28.15
    text: 'Capulet: But fettle your fine joints ''gainst Thursday next,'
  - timestamp: 31.5
    text: 'Capulet: To go with Paris to Saint Peter''s Church,'
  - timestamp: 34.85
    text: 'Capulet: Or I will drag thee on a hurdle thither.'
  - timestamp: 38.15
    text: 'Capulet: Out, you green-sickness carrion! '
  - timestamp: 40.5
    text: 'Capulet: Out, you baggage, you tallow-face!'
  - timestamp: 43.9
    text: 'Lady Capulet: Fie, fie! What, are you mad?'

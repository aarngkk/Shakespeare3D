  m_Script: {fileID: 11500000, guid: 11fcc6676c3e1904c8cd219824caa727, type: 3}
  m_Name: Script2_Subtitles
  m_EditorClassIdentifier: 
  lines:
  - timestamp: 0.5
    text: 'Juliet: Now, by Saint Peter''s Church and Peter too,'
  - timestamp: 4
    text: 'Juliet: He shall not make me there a joyful bride.'
  - timestamp: 7.2
    text: 'Juliet: I wonder at this haste, '
  - timestamp: 9.25
    text: 'Juliet: That I must wed ere he that should be husband comes to woo.'
  - timestamp: 14.1
    text: 'Juliet: I pray you, tell my lord and father, madam,

'
  - timestamp: 17.5
    text: 'Juliet: I will not marry yet;'
  - timestamp: 19.4
    text: "Juliet: And, when I do, I swear it shall be Romeo, \r"
  - timestamp: 22.4
    text: 'Juliet: Whom you know I hate, rather than Paris.'
  - timestamp: 25.6
    text: 'Juliet: These are news indeed!'
  - timestamp: 28.3
    text: 'Lady Capulet: Here comes your father; tell him so yourself,'
  - timestamp: 31.4
    text: 'Lady Capulet: And see how he will take it at your hands.'
